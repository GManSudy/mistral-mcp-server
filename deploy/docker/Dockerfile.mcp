FROM python:3.12-slim
WORKDIR /app
COPY apps/mcp/requirements.txt /app/mcp/requirements.txt
RUN pip install --no-cache-dir -r /app/mcp/requirements.txt
COPY apps/worker/src ./worker_src
COPY apps/mcp ./mcp
ENV PYTHONPATH=/app/worker_src:/app/mcp
EXPOSE 8000
CMD ["python", "mcp/trello_mcp.py", "--http", "--port", "8000"]
