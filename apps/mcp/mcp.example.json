{
  "servers": {
    "openproject": {
      "command": "uv",
      "args": ["run", "openproject-mcp-fastmcp.py"],
      "env": {
        "OPENPROJECT_URL": "https://<your-openproject-instance>",
        "OPENPROJECT_API_KEY": "<token-from-access-tokens>"
      }
    },
    "trello": {
      "command": "python",
      "args": ["apps/mcp/trello_mcp.py"],
      "env": { "TRELLO_API_KEY": "...", "TRELLO_TOKEN": "..." }
    }
  }
}
